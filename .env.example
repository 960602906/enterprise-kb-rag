# Atlas KB — copy to .env.local and fill in values
# cp .env.example .env.local

# Postgres (local docker compose maps 5433 → 5432)
DATABASE_URL=postgresql://kb_rag:kb_rag@localhost:5433/kb_rag

# Auth.js / NextAuth v5
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Optional alias (Auth.js also reads NEXTAUTH_SECRET)
NEXTAUTH_SECRET=
AUTH_URL=http://localhost:43123
# Optional legacy alias
NEXTAUTH_URL=http://localhost:43123

# OpenAI (or compatible) — used for chat + embeddings
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (Azure OpenAI, AI Gateway, local proxy)
OPENAI_BASE_URL=

# Vercel AI Gateway (optional alternative to OPENAI_*)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Dev fallbacks (no API key required)
MOCK_EMBEDDINGS=false
MOCK_CHAT=false

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# Seed script (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=member123456

# Set true to disable POST /api/register (use SSO / seeded users only)
DISABLE_REGISTER=false
