# Atlas KB — copy to .env.local
# cp .env.example .env.local

# Postgres + pgvector (docker compose: localhost:5433, user/pass/db kb_rag)
DATABASE_URL=postgresql://kb_rag:kb_rag@localhost:5433/kb_rag

# Auth.js / NextAuth v5
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=
AUTH_URL=http://localhost:43123
NEXTAUTH_URL=http://localhost:43123

# OpenAI (or compatible) — chat + embeddings
OPENAI_API_KEY=
# Leave unset (do not set to empty) unless using a compatible gateway.
# OPENAI_BASE_URL=

# Vercel AI Gateway (optional)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Local demo without API keys
MOCK_EMBEDDINGS=false
MOCK_CHAT=false

# Uploads — local disk (default) or S3-compatible (MinIO / R2 / OSS / AWS)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=atlas-kb
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# Ingest queue — inline in development; production uses Vercel Cron or `pnpm jobs:work`
# INGEST_WORKER_INLINE=false
# INGEST_MAX_ATTEMPTS=3
# INGEST_POLL_MS=2000
# INGEST_BATCH_SIZE=3
# INGEST_LOCK_TTL_MS=180000
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/ingest
# CRON_SECRET=
# INGEST_CRON_SECRET=

# Seed (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=member123456

# Set true to disable POST /api/register
DISABLE_REGISTER=false

# Service SearchKnowledge API (header: x-api-key).
# Prefer DB-issued keys via Settings → API keys. Legacy env key still works.
SEARCH_KNOWLEDGE_API_KEY=change-me-search-knowledge-key
# SEARCH_KNOWLEDGE_KB_IDS=
SEARCH_KNOWLEDGE_DEFAULT_KB_NAME=Internal Docs
# Unsafe for multi-tenant. DB keys never use this. In production also set:
# SEARCH_KNOWLEDGE_ALLOW_ALL_IN_PRODUCTION=true
SEARCH_KNOWLEDGE_ALLOW_ALL=false
# Optional pepper for hashing DB API keys (defaults to AUTH_SECRET)
# API_KEY_PEPPER=
# In-process rate limits (per isolate). RATE_LIMIT_DISABLED=true skips them.
# CHAT_RATE_LIMIT_PER_MIN=20
# REGISTER_RATE_LIMIT_PER_MIN=5
# SEARCH_RATE_LIMIT_PER_MIN=60

# Retrieval knobs (defaults also in config/retrieval.json)
# RETRIEVAL_CONFIG_PATH=config/retrieval.json
# RETRIEVAL_TOP_K=8
# RETRIEVAL_VECTOR_WEIGHT=0.65
# RETRIEVAL_KEYWORD_WEIGHT=0.35
# RETRIEVAL_MIN_HYBRID_SCORE=0
# RETRIEVAL_FUSION=rrf
# RETRIEVAL_RRF_K=60
# RETRIEVAL_TRGM_MIN_SIMILARITY=0.35

# Optional retrieval synonym overlay (default: config/retrieval-synonyms.json)
# SYNONYM_CONFIG_PATH=config/examples/skyroc-synonyms.json
# EVAL_QUERIES_PATH=config/eval-queries.json
