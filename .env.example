# Atlas KB / enterprise-kb-rag
#
# Self-hosted enterprise knowledge-base RAG. Copy to `.env.local`:
#   cp .env.example .env.local
#
# This project is open-source software you run yourself — it is NOT a free
# public cloud SaaS. Bring your own Postgres, API keys, and host.

# =============================================================================
# Required
# =============================================================================

# Postgres + pgvector (docker compose: localhost:5433, user/pass/db kb_rag)
DATABASE_URL=postgresql://kb_rag:kb_rag@localhost:5433/kb_rag

# Auth.js / NextAuth v5 — generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Optional alias (Auth.js also accepts NEXTAUTH_SECRET)
# NEXTAUTH_SECRET=
AUTH_URL=http://localhost:43123
# NEXTAUTH_URL=http://localhost:43123

# =============================================================================
# AI providers (chat vs embeddings) — bring your own keys
# =============================================================================
# Chat needs a chat-capable model key; embeddings need an embedding model.
# You can use OpenAI, DeepSeek (OpenAI-compatible), or any compatible gateway.
#
# OpenAI:
#   OPENAI_API_KEY=sk-...
#   CHAT_MODEL=gpt-4o-mini
#   EMBEDDING_MODEL=text-embedding-3-small
#
# DeepSeek / OpenAI-compatible (example — check your vendor docs):
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   CHAT_MODEL=deepseek-chat
#   # Embeddings: use a provider that exposes an embeddings endpoint, or keep
#   # OpenAI/Gateway for EMBEDDING_MODEL while pointing chat elsewhere.
#
# Vercel AI Gateway (optional fallback when OPENAI_API_KEY is empty):
#   AI_GATEWAY_API_KEY=
#   # AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

OPENAI_API_KEY=
# Leave OPENAI_BASE_URL unset (do not set to empty) unless using a compatible gateway.
# OPENAI_BASE_URL=

AI_GATEWAY_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Demo-only mocks (deterministic, no API spend). Quality will be poor for real RAG.
# Prefer real embeddings for production / eval quality. Safe default: false.
MOCK_EMBEDDINGS=false
MOCK_CHAT=false

# =============================================================================
# Uploads
# =============================================================================
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=atlas-kb
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# =============================================================================
# Ingest worker (optional in local demo; required pattern for production)
# =============================================================================
# Dev default: omit INGEST_WORKER_INLINE (inline processing on upload/process).
# Production / multi-instance: set false and run Cron or `pnpm jobs:work`.
# INGEST_WORKER_INLINE=false
# INGEST_MAX_ATTEMPTS=3
# INGEST_POLL_MS=2000
# INGEST_BATCH_SIZE=3
# INGEST_LOCK_TTL_MS=180000
# Vercel Cron / drain auth: Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
# INGEST_CRON_SECRET=

# =============================================================================
# Seed users (pnpm db:seed) — CHANGE before any public exposure
# =============================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=member123456

# Set true to disable POST /api/register (recommended in production)
DISABLE_REGISTER=false

# =============================================================================
# SearchKnowledge external API (optional)
# =============================================================================
# Prefer multi-key UI: Settings → API keys  (/settings/api-keys)
# Legacy single env key (optional):
# SEARCH_KNOWLEDGE_API_KEY=
# SEARCH_KNOWLEDGE_KB_IDS=
SEARCH_KNOWLEDGE_DEFAULT_KB_NAME=Internal Docs
# Keep false. Never commit true. DB-issued keys never use ALLOW_ALL.
SEARCH_KNOWLEDGE_ALLOW_ALL=false
# In production, ALLOW_ALL also requires:
# SEARCH_KNOWLEDGE_ALLOW_ALL_IN_PRODUCTION=true
# Optional pepper for hashing DB API keys (defaults to AUTH_SECRET)
# API_KEY_PEPPER=

# In-process rate limits (per isolate). RATE_LIMIT_DISABLED=true skips them.
# CHAT_RATE_LIMIT_PER_MIN=20
# REGISTER_RATE_LIMIT_PER_MIN=5
# SEARCH_RATE_LIMIT_PER_MIN=60

# =============================================================================
# Retrieval knobs (defaults also in config/retrieval.json)
# =============================================================================
# RETRIEVAL_CONFIG_PATH=config/retrieval.json
# RETRIEVAL_TOP_K=8
# RETRIEVAL_VECTOR_WEIGHT=0.65
# RETRIEVAL_KEYWORD_WEIGHT=0.35
# RETRIEVAL_MIN_HYBRID_SCORE=0
# RETRIEVAL_FUSION=rrf
# RETRIEVAL_RRF_K=60
# RETRIEVAL_TRGM_MIN_SIMILARITY=0.35

# Optional synonym overlay / eval fixtures
# SYNONYM_CONFIG_PATH=config/examples/skyroc-synonyms.json
# EVAL_QUERIES_PATH=config/eval-queries.json

# Optional: comma-separated hosts for Next.js HMR behind a reverse proxy (pnpm dev)
# ALLOWED_DEV_ORIGINS=
