# Atlas KB — copy to .env.local
# cp .env.example .env.local

# Postgres + pgvector (docker compose: localhost:5433, user/pass/db kb_rag)
DATABASE_URL=postgresql://kb_rag:kb_rag@localhost:5433/kb_rag

# Auth.js / NextAuth v5
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=
AUTH_URL=http://localhost:43123
NEXTAUTH_URL=http://localhost:43123

# OpenAI (or compatible) — chat + embeddings
OPENAI_API_KEY=
# Leave unset (do not set to empty) unless using a compatible gateway.
# OPENAI_BASE_URL=

# Vercel AI Gateway (optional)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Local demo without API keys
MOCK_EMBEDDINGS=false
MOCK_CHAT=false

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# Seed (pnpm db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=member123456

# Set true to disable POST /api/register
DISABLE_REGISTER=false

# SkyRoc SearchKnowledge (service-to-service). Header: x-api-key
# Local seed — change in production. If unset, development allows localhost only.
SEARCH_KNOWLEDGE_API_KEY=dev-skyroc-search-knowledge
# Optional comma-separated KB UUID allowlist for the API key. Empty = SkyRoc Docs KB, else all KBs.
# SEARCH_KNOWLEDGE_KB_IDS=
